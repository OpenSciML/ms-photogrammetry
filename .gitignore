# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Compiled native C++ shared libraries (built automatically on demand)
*.dylib
*.so
*.dll
*.o

# Virtual environments & packaging
.venv/
venv/
env/
dist/
build/
*.egg-info/

# macOS / OS metadata
.DS_Store
.AppleDouble
.LSOverride
._*

# Large UAV raw imagery & binary raster/point-cloud outputs
data/
*.tif
*.tiff
*.las
*.laz
*.ply

# Keep lightweight documentation previews & reports in output/ if desired
output/*.tif
output/*.las
output/*.ply
output/*.log
